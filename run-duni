#!/usr/bin/env bash
# Built with Claude — do not use in prod.
# Compile a .duni file to WAT, assemble to wasm, run, print result.
# Usage: ./run-duni path/to/file.duni
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $0 <file.duni>" >&2
  exit 64
fi

src="$1"
out_dir="duni-out"
mkdir -p "$out_dir"
wat="$out_dir/duni.wat"
wasm="$out_dir/duni.wasm"

zig build run -- "$src" 2>/dev/null >"$wat"
wat2wasm "$wat" -o "$wasm"
# node + host.js, not wasmtime: wasmtime cannot supply the `host` import that
# `extern fn print` needs. Same runner the test harness uses (test/cases.zig).
node host.js "$wasm"
